# Raw and processed data (keep directory structure only)
data/raw/*
!data/raw/.gitkeep
data/raw/local_assumptions.json
data/processed/*
!data/processed/.gitkeep

# Databases & SQLite journals
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Secrets & local configuration
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
secrets/

# Python & Jupyter artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
ENV/

# OS files
.DS_Store
Thumbs.db
