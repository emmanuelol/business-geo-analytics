# Copy to .env (gitignored) for local or Docker overrides.
# Precedence: defaults < data/raw/local_assumptions.json < env BGA_*

BGA_DATA_MODE=sample
BGA_FETCH_LIVE=0
BGA_BRANCH_ID=TC-001

# Store coordinates (defaults are approximate Silao centroid; set verified=true locally once confirmed)
BGA_LAT=20.95
BGA_LON=-101.42
BGA_COORDS_VERIFIED=false

# Operating schedule and intervention milestones
BGA_PEAK_HOURS=8,9,18,19,20
BGA_LINEBUSTER_START_DATE=none
BGA_TABLET_CHANNEL_START_DATE=2026-09-05
BGA_TABLET_CHANNEL_INTERPRETATION=pos_channel_change

# ROI financial assumptions (placeholder defaults)
BGA_HARDWARE_CAPEX=12000.0
BGA_MONTHLY_SAAS_FEE=1200.0
BGA_PEAK_LABOR_COST_PER_HR=85.0
BGA_GROSS_MARGIN_PCT=0.65
BGA_CURRENCY=MXN
